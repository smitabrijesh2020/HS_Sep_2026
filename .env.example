# --- Database ---
# MVP default: SQLite file. For production, point to an approved PostgreSQL instance.
DATABASE_URL=sqlite:///./hs_nomination.db

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
ORG_TIMEZONE=Asia/Kolkata

# --- Microsoft Graph (Outlook email) ---
# Use certificate-based application auth in production. Never place real secrets in this file
# or in any committed file. Populate real values only in an approved secret manager / vault.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_CERTIFICATE_PATH=/path/to/cert.pem  # placeholder only
GRAPH_SENDER_UPN=hs-automation-noreply@example.org  # placeholder only
GRAPH_DRY_RUN=true

# --- Communication scheduler ---
ESCALATION_DAY0_LAUNCH=0
ESCALATION_DAY_REMINDER_1=3
ESCALATION_DAY_REMINDER_2=5
ESCALATION_DAY_ESCALATION=7
ESCALATION_DAY_FINAL_REMINDER=9
ESCALATION_DAY_CLOSE_REVIEW=11

# --- Retention (organization must confirm; placeholder only) ---
AUDIT_LOG_RETENTION_DAYS=365
COMMUNICATION_LOG_RETENTION_DAYS=365
